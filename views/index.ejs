<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The toBBot Director</title>
  <link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Rajdhani:wght@400;700&family=Roboto:wght@300;400&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.0/anime.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js" defer></script>
  <style>
    :root {
      --bg-color: #000;
      --overlay: rgba(0,0,0,0.6);
      --font-header: 'Audiowide', cursive;
      --font-body: 'Rajdhani', sans-serif;
      --font-topbar: 'Segoe UI', sans-serif;
      --bar-bg: rgba(10,10,10,0.8);
      --search-bg: rgba(255,255,255,0.1);
      --highlight: #ffea00;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: var(--font-body); background: var(--bg-color); color: #e0e0e0; overflow:hidden; }
    canvas#three-bg, #particles-js { position:absolute; top:0; left:0; width:100%; height:100%; }
    canvas#three-bg { z-index:0; }
    #particles-js { z-index:1; }
    .overlay { position:absolute; top:0; left:0; width:100%; height:100%; background: var(--overlay); z-index:2; }
    .top-bar { position:absolute; top:0; left:0; width:100%; background: var(--bar-bg); display:flex; align-items:center; justify-content:space-between; padding:0.5rem 1rem; z-index:4; }
    .nav-links { display:flex; gap:1rem; }
    .nav-links a { text-decoration:none; color:#e0e0e0; font-family: var(--font-topbar); font-weight:700; transition: color 0.2s; }
    .nav-links a:hover { color: var(--highlight); }
    .search-container input { padding:0.4rem 0.6rem; border:none; border-radius:4px; background: var(--search-bg); color:#e0e0e0; outline:none; width:200px; font-family: var(--font-topbar); transition: width 0.3s; }
    .search-container input:focus { width:300px; background:rgba(255,255,255,0.2); }
    .container { position:relative; z-index:3; display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; text-align:center; padding:0 20px; }
    h1 {
      font-family: var(--font-header);
      font-size:4rem;
      background: linear-gradient(-45deg, #ff0044, #00ff99, #0066ff, #ff00ff);
      background-size: 400% 400%;
      animation: rainbow 10s ease infinite;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      opacity:0;
    }
    .cursive { font-family: cursive; display: inline-block; }
    @keyframes rainbow { 0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%} }
    p { margin-top:1rem; font-size:1.2rem; color:#e0e0e2; }
    .invite-container { margin:1.5rem 0; }
    #invite-btn {
      display:inline-block; padding:16px 32px; font-size:1.2rem; font-family: var(--font-body);
      background: linear-gradient(90deg, #ff0080, #ff8c00, #40e0d0);
      background-size: 200% 200%; animation: inviteGradient 5s ease infinite;
      color:#000; border:none; border-radius:50px; cursor:pointer;
      box-shadow:0 0 10px rgba(255,255,255,0.5);
      transition: transform 0.3s;
    }
    #invite-btn:hover { transform: scale(1.05); }
    @keyframes inviteGradient { 0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%} }
    .buttons { margin-top:2rem; display:flex; gap:1rem; }
    .buttons a { padding:12px 30px; font-size:1rem; text-decoration:none; color:#000; background:linear-gradient(45deg,#ff00ff,#00ffff); border-radius:50px; box-shadow:0 0 10px #ff00ff,0 0 20px #00ffff; transition:transform 0.3s; }
    .buttons a:hover { transform:scale(1.1) translateY(-3px); }
  </style>
</head>
<body>
  <canvas id="three-bg"></canvas>
  <div id="particles-js"></div>
  <div class="overlay"></div>
  <%- include('partials/topbar') %>
  <div class="container">
    <h1 id="headline" data-text="The toBBot Director">The toBBot <span class="cursive">Director</span></h1>
    <p>Server time: <span id="time"></span></p>
    <div class="invite-container">
      <button id="invite-btn" onclick="window.open('https://dsc.gg/tobbot','_blank')">Invite toB to your server today</button>
    </div>
    <div class="buttons">
      <a href="/console">/console</a>
      <a href="/help">/help</a>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const scene = new THREE.Scene(); const camera = new THREE.PerspectiveCamera(75,window.innerWidth/window.innerHeight,0.1,1000);
      const renderer = new THREE.WebGLRenderer({canvas:document.getElementById('three-bg'),alpha:true}); renderer.setSize(window.innerWidth,window.innerHeight); camera.position.z=50;
      const knot=new THREE.Mesh(new THREE.TorusKnotGeometry(10,3,100,16),new THREE.MeshBasicMaterial({color:0xffffff,wireframe:true,opacity:0.2,transparent:true})); scene.add(knot);
      (function animate(){requestAnimationFrame(animate);knot.rotation.x+=0.005;knot.rotation.y+=0.01;renderer.render(scene,camera);})();
      particlesJS.load('particles-js','/particles.json');
      anime.timeline({easing:'easeOutExpo',duration:1000}).add({targets:'#headline',opacity:[0,1],scale:[0.8,1]});
      function updateTime(){document.getElementById('time').textContent=new Date().toLocaleTimeString();}
      setInterval(updateTime,1000);updateTime();
      const inviteBtn=document.getElementById('invite-btn'); inviteBtn.addEventListener('mouseenter',()=>{confetti({particleCount:100,spread:70,origin:{y:0.6}});});
      const searchBox=document.getElementById('search-box'); searchBox.addEventListener('input',e=>{const term=e.target.value.toLowerCase();document.querySelectorAll('h1,p,button,a').forEach(el=>{const txt=el.textContent.toLowerCase();el.innerHTML=txt.includes(term)&&term?el.textContent.replace(new RegExp(term,'gi'),match=>`<span style="background:${'#ffea00'};color:#000">${match}</span>`):el.textContent;});});
    });
    window.addEventListener('resize',()=>{renderer.setSize(window.innerWidth,window.innerHeight);camera.aspect=window.innerWidth/window.innerHeight;camera.updateProjectionMatrix();});
  </script>
</body>
</html>
