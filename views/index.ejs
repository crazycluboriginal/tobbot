<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>toBBot Home</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #121212;
      color: #ffffff;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      text-align: center;
    }
    h1 {
      font-size: 3rem;
      color: #00ffc8;
      margin-bottom: 20px;
    }
    p {
      font-size: 1.4rem;
      color: #bbbbbb;
      margin-bottom: 40px;
    }
    a {
      display: inline-block;
      margin: 10px;
      padding: 12px 24px;
      font-size: 1rem;
      text-decoration: none;
      color: #121212;
      background-color: #00ffc8;
      border-radius: 6px;
      transition: background-color 0.3s, transform 0.2s;
    }
    a:hover {
      background-color: #00dab0;
      transform: scale(1.05);
    }
  </style>
</head>
<body>
  <h1>Welcome to toBBot</h1>
  <p>Server time: <%= time %></p>
  <a href="/console">View Console Logs</a>
  <a href="/help">Help & Info</a>
</body>
</html>
