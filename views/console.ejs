      <!DOCTYPE html>
      <html lang="en">
      <head>
        <meta charset="UTF-8">
        <title>toBBot Console</title>
        <style>
          body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121212;
            color: #ffffff;
            padding: 40px;
            margin: 0;
          }
          h1 {
            font-size: 3rem;
            color: #00ffc8;
            text-align: center;
            margin-bottom: 30px;
          }
          ul {
            list-style-type: none;
            padding: 0;
            max-width: 800px;
            margin: 0 auto;
          }
          li {
            background: #1e1e1e;
            margin-bottom: 12px;
            padding: 15px 20px;
            border-left: 5px solid #00ffc8;
            border-radius: 6px;
            font-family: monospace;
            word-break: break-all;
            transition: background 0.3s, transform 0.2s;
          }
          li:hover {
            background: #2a2a2a;
            transform: scale(1.02);
          }
          a {
            display: block;
            text-align: center;
            margin-top: 30px;
            font-size: 1.1rem;
            color: #00aaff;
            text-decoration: none;
            transition: color 0.2s;
          }
          a:hover {
            color: #00ffc8;
          }
        </style>
      </head>
      <body>
        <h1>toBBot Console Logs</h1>
        <ul>
          <% logs.forEach(log => { %>
            <li><%= log %></li>
          <% }); %>
        </ul>
        <a href="/">← Back to Home</a>
      </body>
      </html>
