<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>toBBot Help</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Roboto:wght@300;400&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.0/anime.min.js" defer></script>
  <style>
    :root {
      --bg-img: url('help-background.png');
      --overlay: rgba(0,0,0,0.7);
      --font-header: 'Orbitron', sans-serif;
      --font-body: 'Roboto', sans-serif;
      --text-light: #e0e0e0;
      --accent-gen: #ff4757;
      --accent-config: #3742fa;
      --accent-info: #2ed573;
      --accent-abstract: #ffa502;
      --card-bg: rgba(20,20,20,0.9);
      --bar-bg: rgba(0,0,0,0.8);
      --search-bg: rgba(255,255,255,0.1);
      --highlight: #ffea00;
      --transition: 0.3s ease;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: var(--font-body);
      background: var(--bg-img) center/cover no-repeat fixed;
      color: var(--text-light);
      position: relative;
      min-height: 100vh;
      overflow-x: hidden;
    }
    #particles-js { position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; }
    .overlay { position:absolute; top:0; left:0; width:100%; height:100%; background:var(--overlay); z-index:1; }
    .top-bar {
      position:fixed; top:0; left:0; width:100%;
      background:var(--bar-bg);
      display:flex; justify-content:space-between; align-items:center;
      padding:0.5rem 1rem; z-index:10;
      font-family:'Segoe UI', sans-serif;
    }
    .nav-links { display:flex; gap:1rem; }
    .nav-links a {
      text-decoration:none;
      color:var(--text-light);
      font-family:'Segoe UI', sans-serif;
      font-weight:700;
      transition:color 0.2s;
    }
    .nav-links a:hover { color:var(--highlight); }
    .search-container input {
      padding:0.4rem 0.6rem;
      border:none; border-radius:4px;
      background:var(--search-bg);
      color:var(--text-light);
      outline:none;
      width:200px;
      transition:width 0.3s;
      font-family:'Segoe UI', sans-serif;
    }
    .search-container input:focus {
      width:300px;
      background:rgba(255,255,255,0.2);
    }
    .container {
      position:relative; z-index:2;
      padding:5rem 1rem 2rem;
      max-width:1200px;
      margin:0 auto;
    }
    /* Animated Rainbow Title */
    #main-title {
      font-family: var(--font-header);
      font-size:4.5rem;
      text-align:center;
      background: linear-gradient(-45deg,#ff0044,#00ff99,#0066ff,#ff00ff);
      background-size:400% 400%;
      animation:rainbow 8s ease infinite, pulse 3s ease-in-out infinite;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    @keyframes rainbow {
      0%{background-position:0% 50%}
      50%{background-position:100% 50%}
      100%{background-position:0% 50%}
    }
    @keyframes pulse {
      0%,100%{transform:scale(1)}
      50%{transform:scale(1.05)}
    }
    .intro {
      text-align:center;
      font-size:1.2rem;
      color:var(--text-light);
      margin-bottom:2rem;
    }
    .category { margin-bottom:3rem; }
    .category h2 {
      font-family: var(--font-header);
      font-size:2.5rem;
      margin-bottom:1rem;
      color:currentColor;
    }
    .commands-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
      gap:1.5rem;
    }
    .command-card {
      background:var(--card-bg);
      border-left:5px solid currentColor;
      border-radius:8px;
      padding:1rem;
      opacity:1;
      transform:translateY(0);
      transition:background var(--transition),transform var(--transition);
    }
    .command-card:hover { background:rgba(20,20,20,1); }
    .command-name {
      font-family: var(--font-header);
      font-size:1.3rem;
      margin-bottom:0.5rem;
    }
    .command-desc {
      font-size:0.95rem;
      line-height:1.4;
      color:var(--text-light);
    }
    .general-entertainment { color:var(--accent-gen); }
    .toB-config      { color:var(--accent-config); }
    .informational   { color:var(--accent-info); }
    .abstract-fun    { color:var(--accent-abstract); }
    .highlight { background:var(--highlight); color:#000; }
  </style>
</head>
<body>
  <div id="particles-js"></div>
  <div class="overlay"></div>
  <%- include('partials/topbar') %>
  <div class="container">
    <h1 id="main-title">Help &amp; Information</h1>
    <p class="intro">All commands are slash-prefixed. Use the search bar to find one quickly.</p>
    <div class="category general-entertainment">
      <h2>/ General Entertainment</h2>
      <div class="commands-grid">
        <div class="command-card"><div class="command-name">/rules</div><div class="command-desc">Full guidelines and bot rules.</div></div>
        <div class="command-card"><div class="command-name">/bibleverse</div><div class="command-desc">Receive today’s bible verse.</div></div>
        <div class="command-card"><div class="command-name">/meme</div><div class="command-desc">Fetch a random meme.</div></div>
        <div class="command-card"><div class="command-name">/news</div><div class="command-desc">Latest world events.</div></div>
        <div class="command-card"><div class="command-name">/joke</div><div class="command-desc">Hear a joke.</div></div>
        <div class="command-card"><div class="command-name">/fact</div><div class="command-desc">Discover a fun fact.</div></div>
      </div>
    </div>
    <div class="category toB-config">
      <h2>/ toB Configuration</h2>
      <div class="commands-grid">
        <div class="command-card"><div class="command-name">/say</div><div class="command-desc">Make the bot repeat your message.</div></div>
        <div class="command-card"><div class="command-name">/dm</div><div class="command-desc">Send an anonymous DM to a member.</div></div>
        <div class="command-card"><div class="command-name">/reminder</div><div class="command-desc">Set reminder: /reminder [duration] [channel] [event].</div></div>
        <div class="command-card"><div class="command-name">/poll</div><div class="command-desc">Create poll: /poll [title],[opt1],[opt2].</div></div>
      </div>
    </div>
    <div class="category informational">
      <h2>/ Informational</h2>
      <div class="commands-grid">
        <div class="command-card"><div class="command-name">/trivia</div><div class="command-desc">Test your knowledge with this command!</div></div>
        <div class="command-card"><div class="command-name">/animal</div><div class="command-desc">Cute animal facts, accompanied by a cute animal pic. You may pick the animal you like.</div></div>
        <div class="command-card"><div class="command-name">/quote</div><div class="command-desc">Motivate yourself for the day with inspiring quotes.</div></div>
        <div class="command-card"><div class="command-name">/randomword</div><div class="command-desc">Receive a random dictionary word to broaden your vocabulary.</div></div>
        <div class="command-card"><div class="command-name">/rhyme</div><div class="command-desc">Find rhymes for  your word of choice.</div></div>
        <div class="command-card"><div class="command-name">/thesaurus</div><div class="command-desc">Writing and can't think of what word to use? Use this command to look up synonyms for any given word.</div></div>
        <div class="command-card"><div class="command-name">/convertcurrency</div><div class="command-desc">Convert currencies.</div></div>
        <div class="command-card"><div class="command-name">/define</div><div class="command-desc">Don't understand a word? Use this to find out its meaning immediately.</div></div>
        <div class="command-card"><div class="command-name">/imagetotext</div><div class="command-desc">Instantly extract text from images with the power of AI.</div></div>
        <div class="command-card"><div class="command-name">/weather</div><div class="command-desc">Check the current weather conditions for any city of your choice</div></div>
        <div class="command-card"><div class="command-name">/forecast</div><div class="command-desc">Receive a 5-day forecast for the city of your choice.</div></div>
        <div class="command-card"><div class="command-name">/inflation</div><div class="command-desc">View inflation rates for the country of your choice.</div></div>
        <div class="command-card"><div class="command-name">/history</div><div class="command-desc">Look up historical events from any time.</div></div>
      </div>
    </div>
    <div class="category abstract-fun">
      <h2>/ Abstract & Fun</h2>
      <div class="commands-grid">
        <div class="command-card"><div class="command-name">/random</div><div class="command-desc">Recieve a completely random Reddit post.</div></div>
        <div class="command-card"><div class="command-name">/bucketlist</div><div class="command-desc">Things to try before you die.</div></div>
        <div class="command-card"><div class="command-name">/8ball</div><div class="command-desc">Consult the magic 8ball to decide your fortune.</div></div>
        <div class="command-card"><div class="command-name">/recipe</div><div class="command-desc">Are you hungry? Try this command for some nourishment!</div></div>
        <div class="command-card"><div class="command-name">/vote</div><div class="command-desc">Vote for toB every 12 hours on <a href = "https://top.gg/bot/704185963483496506/vote">top.gg</a> and <a href = "https://discordbotlist.com/bots/tobbot/upvote">discordbotlist</a>. Thanks for supporting us!</div></div>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      particlesJS.load('particles-js','/particles.json');
      anime.timeline({ easing:'easeOutExpo', duration:800 })
        .add({ targets:'#main-title', opacity:[0,1], scale:[0.8,1], duration:1000 });
      anime({ targets:'.intro', opacity:[0,1], translateY:[-10,0], delay:800, duration:600 });
      document.querySelectorAll('.category h2').forEach((el,i) => anime({ targets:el, opacity:[0,1], translateX:[-20,0], delay:1200+i*200, duration:700 }));
      document.querySelectorAll('.command-card').forEach((el,i) => anime({ targets:el, opacity:[0,1], translateY:[20,0], delay:1600+i*50, duration:600 }));
      document.getElementById('search-box').addEventListener('input', e => {
        const term=e.target.value.toLowerCase();
        document.querySelectorAll('.command-card').forEach(card => {
          const name=card.querySelector('.command-name').textContent.toLowerCase();
          card.style.display=name.includes(term)?'block':'none';
        });
      });
    });
  </script>
</body>
</html>
