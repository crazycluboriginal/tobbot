if (message.content.toLowerCase().startsWith('-reminder')) {
  const args = message.content.slice('-reminder'.length).trim().split(/ +/);
  const time = args[0];
  const reminder = args.slice(2).join(' ');
  const channel = message.mentions.channels.first();
  
  if (!time || !reminder || !channel) {
    return message.reply(`Please provide a valid time, channel, and reminder. Usage syntax: \`-reminder [time] [#channel] [reminder]\``);
  }
  const validUnits = ['s', 'm', 'h', 'd'];
  const unit = time.slice(-1);
  const duration = parseInt(time.slice(0, -1));

  if (isNaN(duration) || !validUnits.includes(unit)) {
    return message.reply(`Please provide a valid time. \`Usage: reminder [time] [#channel] [reminder]\``);
  }
  const timeInMs = duration * (() => {
    switch(unit) {
      case 's': return 1000;
      case 'm': return 1000 * 60;
      case 'h': return 1000 * 60 * 60;
      case 'd': return 1000 * 60 * 60 * 24;
    }
  })();
  const reminderDate = new Date(Date.now() + timeInMs);
  reminders.push({
    time: reminderDate,
    reminder: reminder,
    channel: channel,
    user: message.author.tag,
  });
  
  message.reply(`You will be reminded on \`${reminderDate.toLocaleString()}\` to \`${reminder}\` in \`${channel}\`.`);

  setTimeout(() => {
    channel.send(`${message.author}, time's up! you asked to be reminded to ${reminder}.`);
  }, timeInMs);
}


