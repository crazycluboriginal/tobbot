async function sendVerseOfTheDay() {
  try {
    const response = await fetch("https://www.biblegateway.com/votd/get/?format=json");
    const data = await response.json();
    const { verseurl, reference, text } = data.votd;
    const decodedText = he.decode(text).replace(/[[]]/g, "");
    const embed = new Discord.MessageEmbed()
      .setTitle(he.decode(reference))
      .setDescription(decodedText)
      .setURL(`https://www.biblegateway.com/passage/?search=${verseurl}&version=NIV`)
      .setColor("YELLOW")
    const channel = await client.channels.fetch(channelId);
    await channel.send(embed);
  } catch (error) {
    console.error("Error sending verse of the day", error);
  }
}

cron.schedule("0 9 * * *", sendVerseOfTheDay); 

async function sendWordOfTheDay() {
  try {
    const response = await fetch('https://api.wordnik.com/v4/words.json/wordOfTheDay?api_key=lcwzt69rcg3xdo3lqm8ew5439zhm89pbtigty4os863b6d2hy');
    const data = await response.json();
    const word = data.word;
    const definition = data.definitions[0].text;

    const embed = new Discord.MessageEmbed()
      .setColor('#0099ff')
      .setTitle(`Word of the Day: “${word}”`)
      .setDescription(definition);

    const channel = await client.channels.fetch('841107329192951848');

    await channel.send(embed);
  } catch (error) {
    console.error('Error sending word of the day', error);
  }
}
cron.schedule('0 17 * * *', sendWordOfTheDay); 

async function fetchAndSendDailyNews() {
  const apiKey = '59002a36970b49bcb9b073878ab360b6';

  try {
    // Make the API request to fetch world news
    const response = await fetch(`https://newsapi.org/v2/top-headlines?language=en&apiKey=${apiKey}`);
    const data = await response.json();

    const randomIndex = Math.floor(Math.random() * data.articles.length);
    const randomArticle = data.articles[randomIndex];

    const embed = new Discord.MessageEmbed()
      .setColor('#ff0000')
      .setTitle(`News Article of the Day: ${randomArticle.title}`)
      .setDescription(randomArticle.description)
      .setURL(randomArticle.url)
      .setImage(randomArticle.urlToImage);
    
    const channel = await client.channels.fetch("841002213328420914");
    await channel.send(embed);
  } catch (error) {
    console.error("Error sending news article of the day", error);
  }
}
cron.schedule('0 13 * * *', fetchAndSendDailyNews); 


