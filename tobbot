      const totalVotes = Array.from(votes.values()).reduce((a, b) => a + b, 0);
      if (totalVotes === 0) {
        return;
      }
      const results = Array.from(votes.entries()).map(([emoji, voteCount], i) => {
        const percent = ((voteCount / totalVotes) * 100).toFixed(0);
        const bar = '█'.repeat(Math.round(percent / 10));
        return `${emoji} ${options[i]}\n${bar} ${percent}% | (${voteCount})`;
      });
